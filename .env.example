# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional
PORT=3000
# Without a key the server runs the offline "mock" provider (for development)
# PROVIDER=gemini
GEMINI_MODEL=gemini-nano-banana-2.1
# interactions (default) | generateContent  (legacy models such as gemini-2.5-flash-image)
GEMINI_API_MODE=interactions
# Websites allowed to call this API from a browser, comma separated. Use your own domain(s).
ALLOWED_ORIGINS=https://your-shop.com
RATE_LIMIT_PER_MIN=30
# Set to 1 if you run behind nginx / Cloudflare so per-IP limits see real IPs
TRUST_PROXY=0
